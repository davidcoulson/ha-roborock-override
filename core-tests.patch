+"""Q10 availability follows received device messages."""
+
+from datetime import timedelta
+
+from freezegun.api import FrozenDateTimeFactory
+import pytest
+from roborock.roborock_message import RoborockMessage
+
+from homeassistant.const import Platform
+from homeassistant.core import HomeAssistant
+
+from .conftest import FakeDevice
+
+from tests.common import MockConfigEntry, async_fire_time_changed
+
+
+@pytest.mark.parametrize("platforms", [[Platform.VACUUM]])
+async def test_silent_q10_and_recovery(
+    hass: HomeAssistant,
+    setup_entry: MockConfigEntry,
+    fake_q10_vacuum: FakeDevice,
+    freezer: FrozenDateTimeFactory,
+) -> None:
+    """Broker publishes cannot keep a silent robot available indefinitely."""
+    api = fake_q10_vacuum.b01_q10_properties
+    coordinator = setup_entry.runtime_data.b01_q10[0]
+    api.refresh.reset_mock()
+    freezer.tick(timedelta(minutes=10))
+    async_fire_time_changed(hass)
+    await hass.async_block_till_done()
+    api.refresh.assert_awaited()
+    assert not coordinator.last_update_success
+    assert hass.states.get("vacuum.roborock_q10_s5").state == "unavailable"
+    receive = api._channel.subscribe.call_args.args[0]
+    receive(RoborockMessage(protocol=102, payload=b"{}"))
+    assert coordinator.last_update_success
+    assert coordinator.last_exception is None
+    await hass.async_block_till_done()
+    assert hass.states.get("vacuum.roborock_q10_s5").state == "docked"
+    freezer.tick(timedelta(seconds=90))
+    receive(RoborockMessage(protocol=102, payload=b"{}"))
+    freezer.tick(timedelta(seconds=90))
+    await coordinator.async_refresh()
+    assert coordinator.last_update_success
+    unsubscribe = api._channel.subscribe.return_value
+    await hass.config_entries.async_unload(setup_entry.entry_id)
+    unsubscribe.assert_called_once()
