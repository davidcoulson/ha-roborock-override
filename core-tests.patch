+"""Regression coverage for missing V1 problem values."""
+
+import pytest
+
+from homeassistant.components.roborock.binary_sensor import (
+    BINARY_SENSOR_DESCRIPTIONS,
+    RoborockBinarySensorEntity,
+)
+from homeassistant.core import HomeAssistant
+
+from .conftest import FakeDevice
+
+from tests.common import MockConfigEntry
+
+
+@pytest.mark.parametrize(
+    ("key", "field"),
+    [
+        ("water_shortage", "water_shortage_status"),
+        ("dirty_box_full", "dirty_water_box_status"),
+        ("clean_box_empty", "clear_water_box_status"),
+        ("clean_fluid_empty", "clean_fluid_status"),
+    ],
+)
+async def test_missing_problem_value(
+    hass: HomeAssistant,
+    setup_entry: MockConfigEntry,
+    fake_vacuum: FakeDevice,
+    key: str,
+    field: str,
+) -> None:
+    """A missing field is unknown, including comparison based descriptions."""
+    coordinator = setup_entry.runtime_data.v1[0]
+    setattr(fake_vacuum.v1_properties.status, field, None)
+    description = next(d for d in BINARY_SENSOR_DESCRIPTIONS if d.key == key)
+    assert RoborockBinarySensorEntity(coordinator, description).is_on is None
